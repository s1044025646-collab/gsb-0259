{
  "name": "monotonic-ulid-service",
  "version": "1.0.0",
  "description": "Windows 本地单调 ULID 生成与时间顺序核验后端",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "ulidctl": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/ulid.test.js",
    "start": "node dist/cli.js serve",
    "demo": "npm run build && node dist/demo.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "ulid",
    "monotonic",
    "sqlite",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.0"
  }
}
