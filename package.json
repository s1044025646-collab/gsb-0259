{
  "name": "monotonic-ulid-service",
  "version": "1.0.0",
  "description": "本地单调 ULID 生成与时间顺序核验后端（TypeScript + Node.js + SQLite）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-strip-types src/server.ts",
    "serve": "node dist/server.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "demo": "node --experimental-strip-types scripts/demo.ts",
    "cli": "node --experimental-strip-types src/cli.ts"
  },
  "license": "MIT"
}
